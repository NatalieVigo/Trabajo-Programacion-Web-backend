{
  "name": "mesa-ayuda-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:create": "node src/db/crearBase.js",
    "db:migrate": "sequelize db:migrate --options-path .sequelizerc.cjs",
    "db:seed": "sequelize db:seed:all --options-path .sequelizerc.cjs",
    "db:reset": "sequelize db:drop --options-path .sequelizerc.cjs && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:deploy": "npm run db:migrate && npm run db:seed",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
